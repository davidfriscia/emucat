{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // In development and in the tests the sources run directly with Node's type stripping, so only
    // syntax Node can erase is allowed. Servers run the compiled build instead (tsconfig.build.json),
    // because not every Node.js has type stripping (Ubuntu's own package does not).
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "integration", "vitest.config.ts"]
}
