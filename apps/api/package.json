{
  "name": "@emucat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EmuCat REST and WebSocket API.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@emucat/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/websocket": "^11.3.6",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "pino-pretty": "^13.2.0",
    "sharp": "~0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
