# Copy to .env (or run `pnpm env:init`, which also generates random passwords).
# .env is ignored by Git. Never commit real values.

# --- MariaDB ------------------------------------------------------------------
# Used by compose.yaml and by the API. The password values have no defaults on
# purpose: Compose and the API refuse to start until they are set.
DB_HOST=127.0.0.1
# Host port published by Compose. 3307 avoids clashing with a local server on 3306.
DB_PORT=3307
DB_NAME=emucat
DB_USER=emucat
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- API ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for development. Use false for JSON logs in production.
LOG_PRETTY=true
# Root directory for media files on the server, absolute or relative to the
# repository root. The API reads and deletes media files here. Uploads come later.
STORAGE_PATH=var/storage

# --- Authentication -----------------------------------------------------------
# One-time token that authorizes first-administrator setup. Leave empty and the API
# generates one and prints it to its log while setup is pending. If you set it, use
# at least 32 random characters.
SETUP_TOKEN=
# Marks the session cookie Secure. Leave empty for automatic: on when NODE_ENV is
# production. Always use HTTPS and keep this on outside local development.
COOKIE_SECURE=
# A session ends after this long unused, and after the absolute limit regardless.
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720
# The address browsers use, such as https://emucat.example. Only needed when a
# reverse proxy does not preserve the Host header.
PUBLIC_ORIGIN=
# Comma-separated addresses or CIDR ranges of your reverse proxies. Rate limiting is
# per client address, so behind a proxy it needs this to see the real one.
TRUST_PROXY=

# --- Web development server ---------------------------------------------------
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
