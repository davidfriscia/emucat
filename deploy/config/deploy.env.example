# /opt/emucat/config/deploy.env: how this host deploys EmuCat. Read by emucatctl and the deployment service.
# Owner root:emucat-deploy, mode 0640 (emucatctl init and install set this). Values are literal: no quotes,
# no variables, no spaces around `=`. Nothing here is ever accepted from a browser.
#
# This is the test-server example (MARS). See moon.deploy.env.example for production. Nothing here
# depends on the host's name: every value can be changed.

# --- Identity ----------------------------------------------------------------------------------------
# A short lowercase label shown to administrators: test, production, ...
EMUCAT_ENVIRONMENT=test
# The only branch this host ever deploys.
EMUCAT_BRANCH=develop
# The repository, read-only. An SSH URL with a deploy key is recommended. Never put a token in it.
EMUCAT_GIT_URL=git@github.com:OWNER/emucat.git
# Private key of a read-only deploy key, owned by emucat-deploy, mode 0600. emucatctl init creates one
# here if it is missing. Leave empty for a public HTTPS URL. The Git server's host key must be in
# /opt/emucat/config/known_hosts.
EMUCAT_GIT_SSH_KEY=/opt/emucat/config/deploy_key
# Informational: the address users open. TLS is terminated by the external reverse proxy.
EMUCAT_PUBLIC_URL=https://emucat-test.dfri.info

# --- Administrator-triggered updates ------------------------------------------------------------------
# true lets administrators install updates from Settings. Anything else disables the button; updates are
# then only possible from the command line. There is no schedule, timer or webhook either way.
EMUCAT_ADMIN_UPDATES_ENABLED=true

# --- Layout ------------------------------------------------------------------------------------------
# Everything persistent lives under this directory, with a fixed layout:
#   tooling/ repo.git/ releases/ config/ state/ data/media/ backups/
# It must be the directory that holds this file's config/ directory. There are no other path settings.
EMUCAT_ROOT=/opt/emucat
# 0 keeps every database dump in backups/. A positive number keeps only that many of the newest dumps.
EMUCAT_BACKUP_RETENTION_COUNT=0

# --- Accounts ----------------------------------------------------------------------------------------
EMUCAT_DEPLOY_USER=emucat-deploy
# The group that may use the deployment-service socket. The API container joins it by GID.
EMUCAT_SOCKET_GROUP=emucat-socket

# --- Network -----------------------------------------------------------------------------------------
# Where the web container listens for the external reverse proxy: an address the proxy can reach (and
# nobody else), or loopback when the proxy runs on this host.
EMUCAT_BIND_ADDRESS=10.0.0.2
EMUCAT_HTTP_PORT=8095
# Proxies whose X-Forwarded-For is believed, as the web container sees them (comma-separated). A proxy on
# this host appears as the gateway of the edge network; a proxy on another machine, usually as its own
# address. Add that address here.
EMUCAT_TRUSTED_PROXIES=172.31.253.1
# Docker networks. Change them only if they collide with networks already in use on the host.
EMUCAT_EDGE_SUBNET=172.31.253.0/24
EMUCAT_INTERNAL_SUBNET=172.31.254.0/24
EMUCAT_DATABASE_SUBNET=172.31.252.0/24
# How the API container reaches MariaDB on the host. host-gateway is Docker's own host address.
EMUCAT_DB_HOST_GATEWAY=host-gateway
# How emucatctl reaches the same MariaDB from the host itself, for backups and checks.
EMUCAT_HOST_DB_HOST=127.0.0.1

# --- Update behavior ---------------------------------------------------------------------------------
# Run the image checks (type checks and database-free tests) before every deployment.
EMUCAT_VERIFY=true
# Images of this many recent releases are kept for rollback-app.
EMUCAT_KEEP_RELEASES=5
EMUCAT_HEALTH_TIMEOUT_SECONDS=180
