# /etc/emucat/app.env: the API container's environment. Owner root:emucat-deploy, mode 0640.
# Values are literal: no quotes. Never commit the real file.
#
# NODE_ENV, API_HOST, API_PORT, STORAGE_PATH, LOG_PRETTY, TRUST_PROXY, EMUCAT_ENVIRONMENT and the
# deployment-service settings are fixed by deploy/compose.yaml and cannot be changed here.

# --- MariaDB on the host -----------------------------------------------------------------------------
# host.docker.internal is mapped to the host by compose.yaml (EMUCAT_DB_HOST_GATEWAY).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=emucat-db
DB_USER=emucat-usr
# At least 32 random characters, for example: openssl rand -base64 33
DB_PASSWORD=

# --- Browser sessions behind HTTPS -------------------------------------------------------------------
# The address browsers use. The API compares it with the Origin header of every state-changing request.
PUBLIC_ORIGIN=https://emucat-test.dfri.info
# Always true behind the HTTPS proxy: the cookie becomes __Host-emucat_session and is never sent over HTTP.
COOKIE_SECURE=true
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720

# --- First administrator ----------------------------------------------------------------------------
# Optional. Empty: the API prints a one-time token to its log (emucatctl logs api) while setup is pending.
SETUP_TOKEN=

# --- Logging and media limits -----------------------------------------------------------------------
LOG_LEVEL=info
# MEDIA_MAX_UPLOAD_BYTES=67108864
# MEDIA_MAX_PIXELS=40000000
# MEDIA_MAX_DIMENSION=16384
# MEDIA_MAX_CONCURRENT_UPLOADS=4
# MEDIA_PROCESSING_TIMEOUT_SECONDS=30
