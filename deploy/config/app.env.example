# /opt/emucat/config/app.env: the API container's environment. Owner root:emucat-deploy, mode 0640.
# Values are literal: no quotes. Never commit the real file.
#
# NODE_ENV, API_HOST, API_PORT, STORAGE_PATH, NOTES_PATH, LOG_PRETTY, TRUST_PROXY, EMUCAT_ENVIRONMENT and the
# deployment-service settings are fixed by deploy/compose.yaml and cannot be changed here.

# --- MariaDB on the host -----------------------------------------------------------------------------
# host.docker.internal is mapped to the host by compose.yaml (EMUCAT_DB_HOST_GATEWAY).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=emucat-db
DB_USER=emucat-usr
# At least 32 random characters, for example: openssl rand -base64 33
DB_PASSWORD=

# --- Browser sessions behind HTTPS -------------------------------------------------------------------
# The address browsers use. The API compares it with the Origin header of every state-changing request.
PUBLIC_ORIGIN=https://emucat-test.dfri.info
# Always true behind the HTTPS proxy: the cookie becomes __Host-emucat_session and is never sent over HTTP.
COOKIE_SECURE=true
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720

# --- First administrator ----------------------------------------------------------------------------
# Optional. Empty: the API prints a one-time token to its log (emucatctl logs api) while setup is pending.
SETUP_TOKEN=

# --- Logging and media limits -----------------------------------------------------------------------
LOG_LEVEL=info
# MEDIA_MAX_UPLOAD_BYTES=67108864
# MEDIA_MAX_PIXELS=40000000
# MEDIA_MAX_DIMENSION=16384
# MEDIA_MAX_CONCURRENT_UPLOADS=4
# MEDIA_PROCESSING_TIMEOUT_SECONDS=30

# --- The server's own repository connection, the transfer relay and clones (decision 0055) ---------------
# The key, its known_hosts and an optional passphrase file are files in EMUCAT_ROOT/config/repository-ssh
# (id_ed25519, known_hosts, passphrase), owned by the application account. emucatctl passes them to the API
# when they exist: REPOSITORY_SSH_PRIVATE_KEY_PATH, REPOSITORY_SSH_KNOWN_HOSTS_PATH and
# REPOSITORY_SSH_PASSPHRASE_FILE are fixed by deploy/compose.yaml, as is TRANSFER_STAGING_PATH. Never put a key
# or a passphrase in this file. Host keys are always verified against known_hosts; an unknown or changed key
# is refused.
# REPOSITORY_SSH_CONNECT_TIMEOUT_SECONDS=15
# REPOSITORY_SSH_REQUEST_TIMEOUT_SECONDS=60
# Agents that cannot reach a repository themselves may send and fetch archives through this server.
# TRANSFER_RELAY_ENABLED=true
# One chunk per request. Keep it below the proxies' request limits (client_max_body_size, Cloudflare's 100 MB).
# TRANSFER_CHUNK_BYTES=8388608
# How much staging may use in all (default 100 GiB), and how much the disk must keep free (default 2 GiB).
# TRANSFER_MAX_STAGING_BYTES=107374182400
# TRANSFER_MIN_FREE_BYTES=2147483648
# TRANSFER_MAX_CONCURRENT=4
# An upload or download nobody touches for this long is discarded, with its staged bytes.
# TRANSFER_INACTIVITY_TIMEOUT_SECONDS=86400
# TRANSFER_RETENTION_SECONDS=3600

# --- Archive inspection and Archive Explorer (decision 0056) --------------------------------------------
# All optional; the defaults suit the default 1 GiB API container. Nothing here is ever written to disk.
# ARCHIVE_INSPECTION_MAX_ENTRIES=200000
# ARCHIVE_INSPECTION_MAX_DIRECTORY_BYTES=67108864
# ARCHIVE_INSPECTION_MAX_MANIFEST_BYTES=67108864
# ARCHIVE_INSPECTION_MAX_CONCURRENT=2
# ARCHIVE_INSPECTION_TIMEOUT_SECONDS=120
# ARCHIVE_CACHE_MAX_INDEXES=8
# ARCHIVE_CACHE_TTL_SECONDS=600
# ARCHIVE_CACHE_MAX_BYTES=67108864
# ARCHIVE_PREVIEW_TEXT_BYTES=262144
# ARCHIVE_PREVIEW_HEX_BYTES=65536
# ARCHIVE_PREVIEW_IMAGE_BYTES=20971520
# ARCHIVE_PREVIEW_IMAGE_PIXELS=16777216
# ARCHIVE_PREVIEW_PDF_BYTES=26214400
# ARCHIVE_PREVIEW_SEEK_BYTES=16777216
# ARCHIVE_PREVIEW_MAX_CONCURRENT=2
# ARCHIVE_PREVIEW_MAX_QUEUED=8
# ARCHIVE_PREVIEW_TIMEOUT_SECONDS=60
# One file at a time; 0 turns single-file downloads off. Multi-gigabyte disk images are meant to be restored.
# ARCHIVE_DOWNLOAD_MAX_BYTES=104857600
# ARCHIVE_DOWNLOAD_MAX_CONCURRENT=2
# ARCHIVE_DOWNLOAD_MAX_QUEUED=2
# ARCHIVE_DOWNLOAD_TIMEOUT_SECONDS=1800
