# /opt/emucat/config/deploy.env for production (MOON). Same keys and meaning as deploy.env.example; only
# the values that differ from the test server are explained here. Create it with:
#   sudo deploy/bin/emucatctl init --template deploy/config/moon.deploy.env.example

EMUCAT_ENVIRONMENT=production
EMUCAT_BRANCH=main
EMUCAT_GIT_URL=git@github.com:OWNER/emucat.git
EMUCAT_GIT_SSH_KEY=/opt/emucat/config/deploy_key
# Not decided yet. Set it when the production address is known.
EMUCAT_PUBLIC_URL=

# Production starts with updates from the browser DISABLED. Enable them deliberately, after the
# installation has been verified, by changing this to true and restarting emucat-deployer.
EMUCAT_ADMIN_UPDATES_ENABLED=false

EMUCAT_ROOT=/opt/emucat
EMUCAT_BACKUP_RETENTION_COUNT=0
EMUCAT_DEPLOY_USER=emucat-deploy
EMUCAT_SOCKET_GROUP=emucat-socket
# Not decided yet: loopback until the production proxy is known.
EMUCAT_BIND_ADDRESS=127.0.0.1
EMUCAT_HTTP_PORT=8080
EMUCAT_TRUSTED_PROXIES=172.31.253.1
EMUCAT_EDGE_SUBNET=172.31.253.0/24
EMUCAT_INTERNAL_SUBNET=172.31.254.0/24
EMUCAT_DATABASE_SUBNET=172.31.252.0/24
EMUCAT_DB_HOST_GATEWAY=host-gateway
EMUCAT_HOST_DB_HOST=127.0.0.1
EMUCAT_VERIFY=true
EMUCAT_KEEP_RELEASES=5
EMUCAT_HEALTH_TIMEOUT_SECONDS=180
