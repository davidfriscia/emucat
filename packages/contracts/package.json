{
  "name": "@emucat/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain contracts for EmuCat.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
